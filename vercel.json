{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/analyze.js": {
      "maxDuration": 60
    },
    "api/approve.js": {
      "maxDuration": 15
    },
    "api/settle.js": {
      "maxDuration": 30
    },
    "api/reconcile.js": {
      "maxDuration": 20
    },
    "api/payments.js": {
      "maxDuration": 15
    },
    "api/health.js": {
      "maxDuration": 10
    },
    "api/agent.js": {
      "maxDuration": 45
    },
    "api/settlement-network.js": {
      "maxDuration": 15
    },
    "api/v2.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/a2a",
      "destination": "/api/v2/a2a"
    },
    {
      "source": "/mcp",
      "destination": "/api/v2/mcp"
    },
    {
      "source": "/.well-known/agent.json",
      "destination": "/api/v2/a2a?operation=card"
    },
    {
      "source": "/.well-known/agent-card.json",
      "destination": "/api/v2/a2a?operation=card"
    },
    {
      "source": "/api/v2/:resource",
      "destination": "/api/v2?resource=:resource"
    },
    {
      "source": "/api/payment",
      "destination": "/api/payments?kind=detail"
    },
    {
      "source": "/api/settlement-health",
      "destination": "/api/settlement-network?action=health"
    },
    {
      "source": "/api/settlement-quote",
      "destination": "/api/settlement-network?action=quote"
    },
    {
      "source": "/api/settlement-execute",
      "destination": "/api/settlement-network?action=execute"
    },
    {
      "source": "/api/beneficiaries",
      "destination": "/api/payments?kind=beneficiaries&limit=100"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    }
  ]
}
