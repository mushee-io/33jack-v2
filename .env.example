# Groq AI
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_AGENT_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Persistent backend state (Neon/Postgres)
DATABASE_URL=

# Exact approval binding
APPROVAL_HMAC_SECRET=
MAX_DEVNET_USDG_PER_PAYMENT=5

# Optional configured payout quote catalog
ROUTE_QUOTES_JSON=

# Solana Devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_DEVNET_USDG_MINT=4F6PM96JJxngmHnZLBh9n58RH4aTVNWvDs2nuwrT5BP7
SOLANA_SETTLEMENT_RECEIVER=
# JSON array of 64 secret-key bytes. DEVNET ONLY.
SOLANA_DEVNET_PAYER_SECRET_KEY=


# Payout provider adapter
# internal_sandbox keeps the built-in simulator.
# wise_sandbox routes FX quotes and payout creation through Wise Sandbox.
PAYOUT_PROVIDER=internal_sandbox

# Wise Sandbox (only required when PAYOUT_PROVIDER=wise_sandbox)
WISE_SANDBOX_BASE_URL=https://api.wise-sandbox.com/2026Q3
WISE_SANDBOX_TOKEN=
WISE_PROFILE_ID=
WISE_RECIPIENT_ACCOUNT_ID=
# Optional. When set, 33Jack attempts to fund the Wise Sandbox transfer from this test balance.
WISE_BALANCE_ID=

# Leave false for UK/EEA personal API tokens; Wise may require SCA/manual funding.
WISE_AUTO_FUND=false


# Optional deterministic business policy controls.
# Leave single limit blank/0 for no configured cap.
PAYOUT_SINGLE_LIMIT_USD=
PAYOUT_ALLOWED_CURRENCIES=USD,GBP,EUR,CNY,INR
PAYOUT_BLOCKED_COUNTRIES=
PAYOUT_REQUIRE_KYB=false
BUSINESS_KYB_STATUS=not_configured


# Telegram demo channel
# Create a bot with BotFather, store the token only as a server-side secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional comma-separated Telegram chat IDs allowed to use the demo bot.
TELEGRAM_ALLOWED_CHAT_IDS=
# Public deployed 33Jack URL used for invoice analysis + approval handoff.
PUBLIC_APP_URL=https://YOUR-V2-DEPLOYMENT.vercel.app


# WhatsApp Cloud API demo channel
# Keep the access token and Meta app secret server-side only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v25.0
PUBLIC_APP_URL=https://YOUR-V2-DEPLOYMENT.vercel.app


# Settlement Network adapters
# Solana uses the existing Devnet configuration above.
# Morph and Base remain DEMO unless RPC configuration is supplied.
MORPH_RPC_URL=
MORPH_CHAIN_ID=
MORPH_SETTLEMENT_WALLET=
# Server-side only. Never expose in VITE_* variables.
MORPH_SETTLEMENT_PRIVATE_KEY=

BASE_RPC_URL=
BASE_CHAIN_ID=
BASE_SETTLEMENT_WALLET=
# Server-side only. Never expose in VITE_* variables.
BASE_SETTLEMENT_PRIVATE_KEY=


# WeChat Official Account / Service Account channel
# Configure these in the WeChat/Weixin Official Account developer console.
# Callback URL: https://33jack.vercel.app/api/agent?provider=wechat
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Developer-defined callback verification token.
WECHAT_TOKEN=
# 43-character EncodingAESKey from the WeChat server configuration.
WECHAT_ENCODING_AES_KEY=
# Optional separate secret for signed Review & Pay links.
# Falls back to APPROVAL_HMAC_SECRET, then WECHAT_TOKEN.
WECHAT_REVIEW_SECRET=
# Optional short-lived/manual API access token for debugging only.
# Production should normally use APP_ID + APP_SECRET.
WECHAT_ACCESS_TOKEN=


# Admin-only key used by the web app to permanently delete selected Neon records.
# Keep this server-side and private; users enter it only when confirming a deletion.
RECORD_DELETE_SECRET=


# --- 33JACK V2 Celo Mainnet / agent-to-agent API ---
# Set on the separate V2 deployment only. Use an independent V2 Neon database.
# Never use VITE_ prefix for credentials.
CELO_RPC_URL=https://forno.celo.org
CELO_MAX_PAYMENT_USD=100
CELO_MIN_CONFIRMATIONS=2
# JSON object mapping agent IDs to different random keys, each at least 32 characters.
JACK_AGENT_API_KEYS_JSON=
# Separate human approval credential; must NOT match any agent key.
JACK_APPROVAL_API_KEY=

# --- 33JACK V2 operator and agent infrastructure (server-side secrets only) ---
JACK_SESSION_SECRET=
JACK_OPERATORS_JSON=
# Optional single-owner migration only; NEVER multi-tenant customer data.
JACK_ADMIN_SCOPE=
# Agent policy configurator requires a signed-in owner/admin.
# Do not enable old shared approval keys for a production rollout.
JACK_ALLOW_LEGACY_APPROVAL_KEY=
# Daily review cron. No automated wallet signing.
CRON_SECRET=
JACK_SCHEDULE_WORKSPACE_ID=
# Gmail read-only invoice intake; must be approved by the Gmail account owner.
JACK_EMAIL_WORKSPACE_ID=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Paid x402 exact-Celo USDC risk checks; inactive until configured.
JACK_X402_RECEIVER=
JACK_X402_PRICE_UNITS=10000
JACK_X402_FACILITATOR_URL=
JACK_X402_FACILITATOR_API_KEY=
